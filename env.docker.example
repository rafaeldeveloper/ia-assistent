# Exemplo de arquivo .env para Docker
# Copie este arquivo para .env e preencha com seus valores

# OpenAI API Key (obrigatório para transcrição de áudio, opcional para processamento de texto)
OPENAI_API_KEY=sua_chave_openai_aqui

# Caminho do banco de dados (dentro do container)
DB_PATH=/app/data/finances.db

# Prevenir loops (true/false)
PREVENT_LOOP=true

# Ambiente
NODE_ENV=production

